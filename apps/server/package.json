{
  "name": "@workout-app/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@workout-app/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "set-password": "node dist/set-password.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@workout-app/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "~0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "~0.31.11",
    "tsx": "^4.23.15"
  }
}
