{
  "name": "@workout-app/exercise-data",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@workout-app/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "media"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dataset": "node scripts/import.js",
    "images": "tsx --conditions=@workout-app/source scripts/images.ts"
  },
  "dependencies": {
    "@workout-app/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "sharp": "~0.35.5",
    "tsx": "^4.23.15"
  }
}
